+    // Fate cross-layer prefetcher: copy all router weights to host RAM once.
+    // Enabled via DFLASH_FATE=1 (or DFLASH_FATE_CCT=<path> to also union a
+    // cross-layer co-activation table). Zero GPU cost: gates live in RAM and
+    // prediction runs on a CPU worker thread.
+    // Static instance owned here; re-init stops the worker thread first
+    // (stop() joins), then placement-news a fresh object — never move-assign
+    // a running FatePrefetcher (thread self-move is UB).
+    alignas(dflash::common::FatePrefetcher) static char fate_storage[sizeof(dflash::common::FatePrefetcher)];
+    static dflash::common::FatePrefetcher * fate_instance = nullptr;
+    if (fate_instance) {
+        fate_instance->stop();
+        fate_instance->~FatePrefetcher();
+        fate_instance = nullptr;
+    }
+    const char * fate_cct = std::getenv("DFLASH_FATE_CCT");
+    const bool fate_on = (std::getenv("DFLASH_FATE") != nullptr) || fate_cct;
+    if (fate_on) {
+        dflash::common::FateConfig fc;
+        fc.n_layers     = w.n_layer;
+        fc.n_embd       = w.n_embd;
+        fc.n_experts    = w.n_expert;
+        fc.top_k        = w.n_expert_used;
+        fc.max_prefetch = 16;
+        fc.pct_threshold = 0.75f;
+        fate_instance = new (fate_storage) dflash::common::FatePrefetcher(fc);
+        std::vector<const float *> gate_ptrs((size_t)w.n_layer, nullptr);
+        std::vector<float> gate_tmp;
+        bool gates_ok = true;
+        for (int il = 0; il < w.n_layer && gates_ok; ++il) {
+            ggml_tensor * g = w.layers[(size_t)il].ffn_gate_inp;
+            if (!g) { gates_ok = false; break; }
+            gate_tmp.resize(ggml_nbytes(g) / sizeof(float));
+            ggml_backend_tensor_get(g, gate_tmp.data(), 0, ggml_nbytes(g));
+            // keep our own copy alive for init (FatePrefetcher copies again)
+            static std::vector<std::vector<float>> gate_store;
+            gate_store.resize((size_t)w.n_layer);
+            gate_store[(size_t)il] = gate_tmp;
+            gate_ptrs[(size_t)il] = gate_store[(size_t)il].data();
+        }
+        if (gates_ok && fate_instance->init(gate_ptrs.data())) {
+            out.fate = fate_instance;
+            if (fate_cct && fate_instance->load_cct(fate_cct))
+                std::fprintf(stderr, "[pipelined] Fate: CCT table loaded from %s\n", fate_cct);
+            std::fprintf(stderr,
+                "[pipelined] Fate cross-layer prefetcher ON (%d layers x %d experts)\n",
+                w.n_layer, w.n_expert);
+        } else {
+            out.fate = nullptr;
+            std::fprintf(stderr, "[pipelined] Fate init FAILED; running without prefetch\n");
+        }
+    } else {
+        out.fate = nullptr;
+    }
 
