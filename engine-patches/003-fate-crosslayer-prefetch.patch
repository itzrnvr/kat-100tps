                                         sizeof(float) * (size_t)n_embd);
@@ -488,6 +557,20 @@ bool pipelined_decode_one_token(
             int layer_cold_hits = 0;
             // Spark expert cache: pull selected cold experts into spare GPU slots
             // (LRU) so the lookup below serves them on-GPU; after warmup cold->0.
+            // Fate: proactively promote next-layer predicted experts into spare
+            // slots FIRST (they arrive during this layer's FFN compute), so by
