+            if (state.fate && storage.cache_slots > 0) {
+                const int n_hint = state.fate->take(il + 1, state.fate_hint_buf.data(),
+                                                    (int)state.fate_hint_buf.size());
+                for (int i = 0; i < n_hint; ++i) {
+                    const int32_t gid = state.fate_hint_buf[(size_t)i];
+                    if (gid >= 0 && gid < (int)storage.hot_local_by_global.size() &&
